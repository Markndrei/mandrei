# EmailJS — powers the contact form in src/components/ContactSection.tsx
#
# All three are NEXT_PUBLIC because EmailJS is called from the browser. The
# public key is designed to be exposed; the real protection is the domain
# allow-list and the rate limit you set in the EmailJS dashboard.
#
# Get these from https://dashboard.emailjs.com
#   Service ID  → Email Services
#   Template ID → Email Templates
#   Public Key  → Account > General
#
# The template must expect these three variables, matching the form field
# names in ContactSection.tsx:  user_name, user_email, message
#
# Copy this file to .env.local and fill in the values. Set the same three in
# your Vercel project settings, or the deployed form will silently fail.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
